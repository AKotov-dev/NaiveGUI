[NAME]
name=naivegui

[VERSION]
version=0.6.1

[RELEASE]
release=0.mrx10

[GROUP]
group=Accessibility

[DESCRIPTION]
0=Client/Server configuration GUI for NaiveProxy and Caddy
1=---
2=More information: /usr/share/doc/package_name/repack.txt

[MAINTAINER]
maintainer=Alex Kotov

[VENDOR]
vendor=alex_q_2000 (C) 2026

[SUMMARY]
summary=Client/Server configuration GUI for NaiveProxy and Caddy

[URLCOPY]
urlcopy=https://github.com/AKotov-dev/NaiveGUI

[LICENSE]
license=GPLv3

[DEPS]
deps=gtk2 systemd lib64proxy-gnome

[META]
meta=0

[NOARCH]
noarch=0

[DEB]
deb=0

[FILES]
0=/usr/bin/naivegui
1=/usr/share/icons/naivegui.png
2=/etc/systemd/user/naive.service
3=/etc/systemd/user/naive-xray.service
4=/usr/share/applications/naivegui.desktop
5=/opt/naivegui/
6=/usr/share/naivegui/
7=/usr/share/doc/naivegui/

[AFTERINSTALL]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[AFTERREMOVE]
0=#!/bin/bash
1=
2=systemctl daemon-reload

[URL32]
url32=https://github.com/AKotov-dev/NaiveGUI

[PROGRAMNAME]
programname=NaiveGUI

[DEVTOOL]
devtool=Lazarus

[TOOLVERSION]
toolversion=4.4

[INFO]
0=v0.6.1
1=+ naiveproxy v154.0.8037.49-3
2=+ Self-contained RPM & DEB packages
3=
4=v0.6
5=+ Extended domain bypass .ru + .рф
6=+ Replace `sing-box` with `naive + xray`
7=+ HTTPS mode: Improved responsiveness with HTTP/2
8=+ Self-contained RPM & DEB packages
9=
10=**Note:** The configurator has been completely redesigned. The reason is that sing-box doesn't guarantee [quic=false](https://github.com/SagerNet/sing-box/issues/4181) switching, which can cause the connection to be blocked. This behavior is only observed on desktops. You need to recreate your connection to the server.
11=
12=v0.5
13=+ sing-box-1.13.12
14=+ Automatic creation of USER_NAME and AUTH_PASS
15=+ Self-contained RPM & DEB packages
16=
17=v0.4
18=+ sing-box-1.13.5
19=+ Improved service startup control
20=+ Self-contained RPM & DEB packages
21=
